{
  "name": "falcon",
  "version": "0.1.0",
  "description": "Falcon: a debate evidence editor",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "typecheck": "tsc",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && FALCON_DEV=1 electron .\"",
    "electron:start": "electron .",
    "dist": "npm run build && electron-builder"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wizard780/Falcon.git"
  },
  "type": "module",
  "bugs": {
    "url": "https://github.com/Wizard780/Falcon/issues"
  },
  "homepage": "https://github.com/Wizard780/Falcon#readme",
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "fflate": "^0.8.3",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-dropcursor": "^1.8.4",
    "prosemirror-gapcursor": "^1.4.1",
    "prosemirror-history": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.12",
    "prosemirror-state": "^1.4.4",
    "prosemirror-transform": "^1.12.4",
    "prosemirror-view": "^1.42.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wait-on": "^9.5.1"
  },
  "private": true,
  "build": {
    "appId": "app.falcon.editor",
    "productName": "Falcon",
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "fileAssociations": [
      {
        "ext": "docx",
        "name": "Word Document",
        "role": "Editor"
      }
    ]
  }
}
